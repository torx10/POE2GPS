<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Overlay</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- App version — bump per release and tag the repo to match (vX.Y.Z). UpdateChecker compares this
         to the latest GitHub release/tag so the user is told when they're out of date. -->
    <Version>0.42.4</Version>

    <!-- Ordinary local builds, including `dotnet build -c Release`, are custom development builds.
         Release CI sets ContinuousIntegrationBuild=true; publish.ps1 marks its default `dev` package. -->
    <POE2GPSLocalBuild Condition="'$(POE2GPSLocalBuild)' == '' and '$(ContinuousIntegrationBuild)' != 'true'">true</POE2GPSLocalBuild>
    <POE2GPSLocalBuild Condition="'$(POE2GPSLocalBuild)' == ''">false</POE2GPSLocalBuild>

  </PropertyGroup>

  <ItemGroup Condition="'$(POE2GPSLocalBuild)' == 'true'">
    <AssemblyMetadata Include="POE2GPSBuild" Value="local" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Neutral binary metadata (identity hygiene): keep the PE version-info generic, no author/company
         strings baked in. The published exe is also string-scrubbed by scripts/scrub-strings.ps1. -->
    <Company></Company>
    <Authors></Authors>
    <Product>Overlay</Product>
    <AssemblyTitle>Overlay</AssemblyTitle>
    <Description></Description>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="POE2Radar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\POE2Radar.Core\POE2Radar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.*" />
    <PackageReference Include="System.Windows.Extensions" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\AtlasIcons\*.png" />
    <EmbeddedResource Include="Web\default_watched.json" />
    <EmbeddedResource Include="Web\default_campaign_objectives.json" />
    <EmbeddedResource Include="Web\labels.json" />
    <EmbeddedResource Include="Web\presets\high_contrast.poe2preset" />
    <EmbeddedResource Include="Web\presets\minimal.poe2preset" />
    <EmbeddedResource Include="Web\presets\boss_hunter.poe2preset" />
    <EmbeddedResource Include="Web/Assets/map.html" />
    <EmbeddedResource Include="Web/Assets/map.css" />
    <EmbeddedResource Include="Web/Assets/map.js" />
    <EmbeddedResource Include="Web/Assets/atlas-icons.json" />
    <EmbeddedResource Include="Web/Assets/supporters.json" />
    <EmbeddedResource Include="Web/Assets/dashboard.css" />
    <EmbeddedResource Include="Web/Assets/dashboard.html" />
    <EmbeddedResource Include="Web/Assets/dashboard.js" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\starter-icons\*.png" LogicalName="POE2Radar.Overlay.StarterIcons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\starter-icons\ATTRIBUTION.md" LogicalName="POE2Radar.Overlay.StarterIcons.ATTRIBUTION.md" />
    <EmbeddedResource Include="..\..\assets\starter-icons\mapping.json.default" LogicalName="POE2Radar.Overlay.StarterIcons.mapping.json" />
  </ItemGroup>

</Project>
